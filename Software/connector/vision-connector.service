# /etc/systemd/system/vision-connector.service — installed at ENROLMENT only
# (the connector code ships with the runtime on every device, but runs
# solely where /etc/iovision/config.yaml exists).
# LEGACY (v4.x) line: the runtime lives in /home/pi/wittypi, so the
# connector does too — config.yaml's vision_home must match.
[Unit]
Description=visIOn connector (iovision fleet telemetry + commands)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
ExecStart=/usr/bin/python3 /home/pi/wittypi/connector/agent.py -c /etc/iovision/config.yaml
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
